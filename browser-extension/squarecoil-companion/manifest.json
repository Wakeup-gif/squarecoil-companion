{
  "manifest_version": 3,
  "name": "US Sign SquareCoil Companion",
  "version": "0.7.1",
  "version_name": "0.7.1 Companion Workspace",
  "description": "A local SquareCoil companion for time context, themes, dashboard summaries, settings, and privacy-safe diagnostics.",
  "permissions": ["storage", "scripting", "webRequest"],
  "host_permissions": [
    "https://ussignandmill.squarecoil.net/*",
    "https://www.bing.com/*"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "action": {
    "default_title": "SquareCoil Companion",
    "default_popup": "popup/popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://ussignandmill.squarecoil.net/*"],
      "js": ["dist/presentation-bootstrap.js", "dist/content-controller.js"],
      "run_at": "document_start",
      "all_frames": false,
      "match_about_blank": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dist/themes/dark-glass.css", "dist/themes/light-glass.css"],
      "matches": ["https://ussignandmill.squarecoil.net/*"]
    }
  ]
}
